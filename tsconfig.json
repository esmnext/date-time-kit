{
  "compilerOptions": {
    "lib": ["DOM", "ES2020"],
    "target": "ES2020",
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,

    "declaration": true,

    /* modules */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    /* type checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["./type.d.ts"],
    "paths": {
      "@/*": ["./src/*"],
      "*": ["./type.d.ts"]
    }
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src", "src/**/*.d.ts", "src/**/*.ts", "type.d.ts" ]
}
{
    "name": "@gez/date-time-kit",
    "template": "monorepo",
    "version": "1.1.10",
    "type": "module",
    "scripts": {
        "prepare": "node ./prepare.mjs",
        "lint:js": "biome check --write --no-errors-on-unmatched",
        "build": "pnpm build",
        "lint:type": "pnpm --filter \"*\" lint:type",
        "lint:css": "pnpm --filter \"*\" lint:css",
        "build:packages": "pnpm --filter \"./packages/**\" build",
        "release": "pnpm run build:packages && lerna publish --force-publish --exact",
        "test": "pnpm --filter \"*\" test"
    },
    "engines": {
        "lerna": ">=8",
        "node": ">=24",
        "pnpm": ">=10"
    },
    "devDependencies": {
        "lint-staged": "16.1.2",
        "husky": "9.1.7",
        "@biomejs/biome": "1.9.4"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@biomejs/biome",
            "@gez/router-vue",
            "esbuild"
        ],
        "ignoredBuiltDependencies": [
            "core-js",
            "swiper",
            "puppeteer",
            "protobufjs"
        ]
    },
    "private": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "workspaces": [
        "packages/*",
        "examples/*"
    ]
}
